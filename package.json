{
  "name": "@shopvento/ui",
  "version": "0.4.0",
  "description": "React booking, voucher, customer account and shop components for the Shopvento storefront API",
  "license": "MIT",
  "author": "digital cuisine GmbH & Co. KG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopventoapp/ui.git"
  },
  "homepage": "https://shopvento.de/dev",
  "bugs": {
    "url": "https://github.com/shopventoapp/ui/issues"
  },
  "keywords": [
    "shopvento",
    "react",
    "booking",
    "vouchers",
    "customer-account",
    "storefront",
    "ecommerce",
    "components"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./shop.css": "./dist/shop.css",
    "./forms.css": "./dist/forms.css",
    "./forms": {
      "types": "./dist/public-forms-entry.d.ts",
      "import": "./dist/public-forms-entry.js",
      "default": "./dist/public-forms-entry.js"
    },
    "./shop-flow": {
      "types": "./dist/shop-flow-entry.d.ts",
      "import": "./dist/shop-flow-entry.js",
      "default": "./dist/shop-flow-entry.js"
    },
    "./shop-flow.css": "./dist/shop-flow.css",
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js",
      "default": "./dist/proxy.js"
    },
    "./proxy/node": {
      "types": "./dist/proxy-node.d.ts",
      "import": "./dist/proxy-node.js",
      "default": "./dist/proxy-node.js"
    },
    "./branding": {
      "types": "./dist/branding.d.ts",
      "import": "./dist/branding.js",
      "default": "./dist/branding.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/public-forms-entry.ts src/shop-flow-entry.ts src/proxy.ts src/proxy-node.ts src/branding.ts --format esm --dts --external react --external react-dom --clean && bun run scripts/copy-css.ts",
    "lint": "biome check src tests scripts examples && tsc --noEmit",
    "test": "bun test",
    "pack": "bun run build && bun pm pack --destination artifacts",
    "generate:client": "bun run scripts/generate-client.ts",
    "typecheck": "tsc --noEmit && tsc -p examples/tsconfig.json",
    "generate:shop-client": "bun run scripts/generate-shop-client.ts",
    "format:generated": "biome format --write",
    "typecheck:examples:built": "tsc -p examples/tsconfig.built.json",
    "docs:build": "bun run scripts/build-docs.ts",
    "docs:check": "bun run scripts/check-docs-links.ts",
    "export:openapi": "bun run scripts/export-public-openapi.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "marked": "18.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redoc": "3.0.1",
    "tsup": "^8.5.0",
    "typedoc": "0.28.20",
    "typescript": "^5.9.0"
  }
}
